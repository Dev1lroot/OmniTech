{
  "type": "minecraft:sequence",
  "sequence": [
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:vertical_gradient",
        "random_name": "omnitech:bedrock_floor",
        "true_at_and_below": {
          "above_bottom": 0
        },
        "false_at_and_above": {
          "above_bottom": 3
        }
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": "minecraft:bedrock"
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:stone_depth",
        "add_surface_depth": false,
        "offset": 0,
        "secondary_depth_range": 14,
        "surface_type": "floor"
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": "omnitech:surface_regolith"
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:stone_depth",
        "add_surface_depth": false,
        "offset": 0,
        "secondary_depth_range": 44,
        "surface_type": "floor"
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": "omnitech:stratified_regolith"
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:not",
        "invert": {
          "type": "minecraft:y_above",
          "anchor": {
            "absolute": 48
          },
          "surface_depth_multiplier": 1,
          "add_stone_depth": false
        }
      },
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:noise_threshold",
              "noise": "omnitech:lunar_kreep",
              "min_threshold": 0.62,
              "max_threshold": 9.0,
              "is_3d": true
            },
            "then_run": {
              "type": "minecraft:block",
              "result_state": "omnitech:lunar_kreep"
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": [
                "omnitech:moon_plains"
              ]
            },
            "then_run": {
              "type": "minecraft:block",
              "result_state": "omnitech:lunar_mare_basalt"
            }
          },
          {
            "type": "minecraft:block",
            "result_state": "omnitech:lunar_anorthosite"
          }
        ]
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:stone_depth",
        "add_surface_depth": false,
        "offset": 0,
        "secondary_depth_range": 59,
        "surface_type": "floor"
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": "omnitech:paleoregolith"
      }
    },
    {
      "type": "minecraft:block",
      "result_state": "omnitech:megaregolith"
    }
  ]
}
